[Unit]
Description=Jingkao Journal API
After=network.target

[Service]
Type=simple
User=jingkao
Group=jingkao
WorkingDirectory=/opt/jingkao-api
EnvironmentFile=/etc/jingkao-api.env
ExecStart=/usr/bin/python3 /opt/jingkao-api/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jingkao

[Install]
WantedBy=multi-user.target

